{
  "manifest_version": 3,
  "name": "SourceClip",
  "description": "A privacy-first clipboard tool for Windows that remembers where copied text came from.",
  "version": "0.1.2",
  "icons": {
    "16": "icons/sourceclip-16.png",
    "32": "icons/sourceclip-32.png",
    "48": "icons/sourceclip-48.png",
    "128": "icons/sourceclip-128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "clipboardWrite", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SourceClip",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/sourceclip-16.png",
      "32": "icons/sourceclip-32.png",
      "48": "icons/sourceclip-48.png",
      "128": "icons/sourceclip-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
